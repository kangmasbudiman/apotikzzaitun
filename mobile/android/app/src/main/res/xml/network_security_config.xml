<?xml version="1.0" encoding="utf-8"?>
<!--
  Izinkan koneksi HTTP (bukan HTTPS) ke server kasir.

  Android 9+ memblokir cleartext secara bawaan. Server kasir umumnya berjalan
  di jaringan lokal tanpa sertifikat TLS, jadi perlu diizinkan eksplisit.

  CATATAN PENTING:
  Android TIDAK mendukung filter berbasis rentang CIDR di sini, hanya
  hostname atau IP persis. Karena IP server di jaringan lokal bisa berubah
  karena DHCP, mencantumkan satu IP akan cepat usang. Maka cleartext diizinkan
  untuk seluruh koneksi, dan risikonya (kemungkinan ada man-in-the-middle di
  jaringan lokal) disadari.

  Kalau server nanti dipindah ke domain dengan HTTPS, hapus blok base-config
  di bawah dan pakai domain-config persis seperti contoh di atas.
-->
<network-security-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- Emulator Android: alias dari localhost mesin pengembang -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>